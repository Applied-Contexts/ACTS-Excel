{
  "name": "acts-excel",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Local spreadsheet analysis with SQL, recoverable previews, and interactive MCP tool faces",
  "author": "Applied Contexts",
  "repository": "https://github.com/Applied-Contexts/ACTS-Excel",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "start": "node dist/server.mjs",
    "bundle": "node scripts/package.mjs",
    "test:ui": "playwright test",
    "test:package": "node --test tests/release.check.mjs",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build",
    "test:host": "node tests/host.check.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "overrides": {
    "tmp": "^0.2.5",
    "node-forge": "1.4.0"
  },
  "license": "MIT",
  "bin": {
    "acts-excel": "dist/server.mjs"
  },
  "files": [
    "dist/server.mjs",
    "dist/app.html",
    "dist/build-info.json",
    "dist/notices"
  ]
}
